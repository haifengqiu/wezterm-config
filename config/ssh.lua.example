return function(wezterm, config)
  -- ===================== 核心：SSH多路复用持久连接配置 =====================
  -- 用法：复制本文件为 ssh.lua，填入你自己的服务器信息后使用。
  --       ssh.lua 已在 .gitignore 中忽略，不会被提交，避免泄露真实服务器。
  config.ssh_domains = {
    {
      -- 该 domain 的唯一名称，配置文件内不可重复
      name = 'my-server',

      -- 远程主机地址，可为域名或 IP，末尾可带 ":port"
      remote_address = 'example.com:22',

      -- 登录用户名
      username = 'your_username',

      -- 连接读超时（秒）
      timeout = 60,

      -- 是否在 wezterm 启动时自动连接
      -- connect_automatically = true,

      -- 远程 wezterm 二进制路径（当其不在 $PATH 时指定）
      -- remote_wezterm_path = "/home/your_username/bin/wezterm"
    },
    {
      -- 第二个 domain 示例：可配置多台服务器
      name = 'another-server',
      remote_address = '192.168.1.10:22',
      username = 'user',
      timeout = 60,
    },
  }

end
